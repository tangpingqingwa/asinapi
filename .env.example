# Copy to .env on the VPS. Never commit real secrets.

# Process binds 0.0.0.0:$PORT (default 3000).
PORT=3000

NODE_ENV=production

# Required when NODE_ENV=production. Persist this path on a volume.
ASINAPI_DATABASE=/app/data/asinapi.sqlite

# Optional first key when the keys table is empty. ak_live_... or ak_test_...
# ASINAPI_BOOTSTRAP_KEY=ak_live_replace_me

# Live Amazon is off unless ASINAPI_ADAPTER=live. CI forces fixtures.
# ASINAPI_ADAPTER=live
# ASINAPI_FIXTURE_ONLY=1
